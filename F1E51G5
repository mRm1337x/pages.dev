.lpx-card {
    max-width: 620px;
    width: 100%;
    margin: 20px auto;
    position: relative;
    overflow: hidden;
    border-radius: 24px;
    padding: 28px 24px;
    background: radial-gradient(circle at top left, #000000, #141413 60%, #ecef34);
    border: 1px solid rgba(255, 217, 0, 0.45);
    box-shadow: 0 18px 40px rgba(0,0,0,.35);
    color: #fff;
}

.lpx-card::before {
    content: "☾";
    position: absolute;
    top: 18px;
    right: 28px;
    font-size: 70px;
    color: rgba(255, 230, 120, .28);
    text-shadow: 0 0 25px rgba(255, 217, 0, .55);
}

.lpx-card::after {
    content: "✦ ✧ ✦ ✧ ✦ ✧";
    position: absolute;
    top: 25px;
    left: 22px;
    width: 90%;
    font-size: 18px;
    letter-spacing: 18px;
    color: rgba(255,255,255,.55);
    animation: starFloat 6s ease-in-out infinite alternate;
}

@keyframes starFloat {
    from { transform: translateY(0); opacity: .45; }
    to { transform: translateY(12px); opacity: .9; }
